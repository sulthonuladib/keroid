# Gradle and Android build output
/build
/app/build
/.gradle
/.kotlin
/captures
*.iml
*.hprof
kls_database.db*
/.idea/
/.vscode/
.DS_Store

# Per-machine configuration: SDK path and local signing overrides.
/local.properties

# Generated by scripts/build-core.sh (gomobile AAR) and scripts/build-ghostty.sh.
# Both are rebuilt from source, so they are not in the repository.
/app/libs/*.aar
/app/libs/*.jar
/app/src/main/jniLibs/

# Local toolchains and read-only reference clones, rebuilt by scripts/.
/.tools/
/repos/
/core/bin/

# Release outputs and Python tooling caches.
/dist/
__pycache__/
*.pyc

# Signing material. Never commit: see docs/development.md.
# Losing the key breaks future updates.
/signing/
/keystore/
*.jks
*.keystore
*.p12
*.pem
*.pfx
*.key
*.mobileprovision
.env
.env.*
